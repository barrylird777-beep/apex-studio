{
  "name": "apex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/api/server.ts --dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "tsx src/api/server.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "node scripts/migrate-postgres.mjs",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:migrate:workers": "node scripts/migrate-postgres.mjs",
    "verify:migrations": "node scripts/verify-migrations.mjs --dir drizzle --expect scripts/spec005-expectations.json",
    "smoke:005": "node scripts/smoke-005.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "db:migrate:postgres": "node scripts/migrate-postgres.mjs",
    "verify:official-runtime": "bash scripts/official-release-runtime.sh",
    "verify:speed": "bash scripts/official-cellular-speed-mptcp.sh",
    "verify:mptcp": "bash scripts/mptcp-multipath-observe.sh",
    "mptcp:lab": "bash scripts/mptcp-multipath-lab.sh",
    "verify:starlink": "bash scripts/starlink-priority-backhaul.sh",
    "backhaul:score": "bash scripts/apex-backhaul-score.sh",
    "backhaul:mesh": "bash scripts/apex-decentralized-backhaul.sh",
    "backhaul:fabric": "bash scripts/apex-backhaul-fabric.sh",
    "backhaul:max": "bash scripts/apex-network-max.sh"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "@react-pdf/renderer": "^4.1.6",
    "@tanstack/react-query": "^5.62.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.38.3",
    "lucide-react": "^0.469.0",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1",
    "express": "^5.1.0",
    "cors": "^2.8.5",
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.1",
    "postcss": "^8.4.49",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "@types/pg": "^8.15.5"
  },
  "engines": {
    "node": ">=22"
  }
}