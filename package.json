{
  "name": "apex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/api/server.ts --dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "tsx src/api/server.ts",
    "test": "node --test test/apex-breakaway.test.mjs test/apex-ring-wal.test.mjs test/apex-atomicity.test.mjs test/durable-worker-race.test.mjs test/schedule.test.mjs test/jobs.test.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "test:search:planner": "node scripts/adversarial-bible-trigram-planner.mjs",
    "test:warp": "node src/tests/load/warp_swarm_benchmark.mjs",
    "durable:worker": "node src/jobs/durable-worker-daemon.mjs",
    "network:select": "node src/network/path-selector.mjs",
    "test:render-performance": "node --test test/render-performance.test.mjs",
    "test:network": "node --test test/network-throughput.test.mjs test/network-status.test.mjs test/storage-stream.test.mjs test/http-range-transfer.test.mjs",
    "test:wal": "node --test test/apex-ring-wal.test.mjs",
    "test:atomic": "node --test test/apex-ring-wal.test.mjs test/apex-atomicity.test.mjs test/durable-worker-race.test.mjs",
    "crew": "node src/jobs/apex-crew-daemon.mjs",
    "crew:overseer": "APEX_CREW_ROLE=overseer node src/jobs/apex-crew-daemon.mjs",
    "crew:network": "APEX_CREW_ROLE=network node src/jobs/apex-crew-daemon.mjs",
    "crew:status": "node -e \"import('./src/core/apex-crew.mjs').then(async m=>console.log(JSON.stringify(await m.crewStatus(),null,2)))\""
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "@react-pdf/renderer": "^4.1.6",
    "@tanstack/react-query": "^5.62.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1",
    "express": "^5.1.0",
    "cors": "^2.8.5",
    "fluent-ffmpeg": "^2.1.3",
    "openai": "^6.15.0",
    "@aws-sdk/client-s3": "^3.879.0",
    "@aws-sdk/s3-request-presigner": "^3.879.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=22"
  }
}
