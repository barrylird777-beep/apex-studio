    "test": "node --test test/projects.test.mjs test/characters.test.mjs test/scripture.test.mjs test/scenes.test.mjs test/schedule.test.mjs test/migrations.test.mjs test/schedule-api.smoke.mjs test/jobs.test.mjs test/editor-engine.test.mjs test/video-foundation.test.mjs test/durable-worker-race.test.mjs test/capacity-contract.test.mjs test/search.test.mjs test/ai-crew-engine.test.mjs test/rf-anomaly-dispatcher.test.mjs test/garden-of-apex.test.mjs",
