{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": [
    "server.mjs",
    "index.mjs",
    "src/**/*.mjs",
    "scripts/**/*.mjs",
    "test/**/*.mjs"
  ],
  "exclude": ["node_modules", "data"]
}
