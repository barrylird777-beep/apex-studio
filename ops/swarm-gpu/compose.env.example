# Required: private Unix-domain socket created by the Node Peer-CAS bridge runner.
# The host socket must exist before Compose starts and be mounted into the vLLM container.
APEX_PEER_CAS_BRIDGE=unix:///tmp/apex_peer_cas.sock
APEX_PEER_CAS_TOKEN=replace-with-a-random-secret-at-least-32-characters
APEX_PEER_CAS_NAMESPACE=KernelVision
APEX_MODEL_ID=Qwen/Qwen2.5-Coder-32B-Instruct
APEX_MODEL_REVISION=main
HF_HUB_OFFLINE=1
HF_DATASETS_OFFLINE=1
TRANSFORMERS_OFFLINE=1
GPU_MEMORY_UTILIZATION=0.92
MAX_MODEL_LEN=32768
SWARM_BASE_URL=http://127.0.0.1:8000/v1
SWARM_API_KEY=local
SWARM_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
SWARM_CONCURRENCY=6
SWARM_MAX_RETRIES=4
