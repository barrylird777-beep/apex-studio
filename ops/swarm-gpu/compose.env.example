# Required: point at the Node bridge reachable from the worker's private network.
# Use HTTPS for a non-loopback bridge; loopback HTTP is accepted only in a shared network namespace.
APEX_PEER_CAS_BRIDGE=http://127.0.0.1:8765
APEX_PEER_CAS_TOKEN=replace-with-a-random-secret-at-least-32-characters
APEX_PEER_CAS_NAMESPACE=KernelVision
APEX_MODEL_ID=Qwen/Qwen2.5-Coder-32B-Instruct
APEX_MODEL_REVISION=main
HF_HUB_OFFLINE=1
HF_DATASETS_OFFLINE=1
TRANSFORMERS_OFFLINE=1
GPU_MEMORY_UTILIZATION=0.92
MAX_MODEL_LEN=32768
SWARM_BASE_URL=http://127.0.0.1:8000/v1
SWARM_API_KEY=local
SWARM_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
SWARM_CONCURRENCY=6
SWARM_MAX_RETRIES=4
