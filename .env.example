APEX_BIND_HOST=0.0.0.0
PORT=3010
APEX_LAN_ONLY=true
APEX_COMMANDER_TOKEN=change-me
APEX_IDLE_MINUTES=30
APEX_AUTH_FILE=./.apex_auth/owner.json
APEX_REQUIRE_LOGIN_LOCAL=false
APEX_ORIGIN=
APEX_MAX_UPLOAD_MB=2048
APEX_UPLOAD_DIR=./uploads
APEX_FREE_MODE=true
DISABLE_TELEMETRY=true
APEX_PROTOCOL_OFFSWITCH=NILLY-WILLY
APEX_ENV=production_sandboxed

APEX_SEX_CONCURRENCY=4
APEX_SEX_TIMEOUT_MS=12000
APEX_OMNI_DB_FILE=./apex-omni.sqlite
APEX_EXTENSION_ROOTS=./extensions

# SE-X public research egress policy
APEX_SEX_ALLOWED_HOSTS=
APEX_SEX_MAX_RESPONSE_BYTES=2097152
APEX_SEX_CONTAINER=apex-se-x
APEX_SEX_NETWORK=apex-search
APEX_SEX_IMAGE=registry.apex.internal/apex/se-x@sha256:REPLACE_WITH_APPROVED_DIGEST

# Host security paths (deployment host)
APEX_TLS_DIR=/srv/apex/secrets/tls
APEX_CA_DIR=/srv/apex/secrets/ca
APEX_TLS_REQUIRE_13=false
APEX_SECURITY_POLL_MS=5000
APEX_SECURITY_DEBOUNCE_MS=30000
APEX_SECURITY_AUTO_ISOLATE=false
APEX_SECURITY_EVIDENCE_DIR=./data/security
APEX_SECURITY_LOCK_FILE=./data/security/production.lock
APEX_SEX_EXPECTED_NETWORK_MEMBERS=apex-se-x

# Inference mesh — free-path providers
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://apex-studio-production.up.railway.app
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/zai-org/glm-4.7-flash

POLLINATIONS_API_KEY=

# Media models
POLLINATIONS_TEXT_MODEL=mistral
POLLINATIONS_IMAGE_MODEL=flux
POLLINATIONS_VIDEO_MODEL=wan

# Additional zero-cost inference paths
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025
# Optional self-hosted/local zero-marginal-cost provider
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3:8b

# Safety: metered/credit-based gateways stay OFF unless explicitly enabled.
APEX_ALLOW_METERED_PROVIDERS=false
APEX_PROVIDER_COOLDOWN_MS=60000
APEX_INFERENCE_ORDER=

# Optional metered providers (never used while APEX_ALLOW_METERED_PROVIDERS=false)
HF_TOKEN=
HF_TTS_MODEL=espnet/kan-bayashi_ljspeech_vits
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
AIMLAPI_API_KEY=
AIMLAPI_MODEL=gpt-4o-mini
AIMLAPI_BASE_URL=https://api.aimlapi.com/v1/chat/completions
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.1-8B-Instruct
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1/chat/completions
