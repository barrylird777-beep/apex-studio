# Apex sovereign runtime defaults — TEMPLATE ONLY. Production remains blocked until each app's system-of-record is explicitly wired to its authenticated peer-owned CAS adapter.
NODE_ENV=production
APEX_SE_X_ROOT=/srv/apex/se-x
APEX_PROJECTS_DIR=/srv/apex/se-x/projects
FFMPEG_PATH=ffmpeg

# Generate tokens with `openssl rand -hex 32`; never commit real values.
# Production API tokens must be at least 32 UTF-8 bytes. APEX_CONTROL_TOKEN is a fallback alias for APEX_SHORTCUT_TOKEN;
# set one canonical control token unless intentionally managing both aliases. Keep research/opportunity/worker tokens separate.
APEX_OWNER_PASSWORD=
APEX_SHORTCUT_TOKEN=
APEX_CONTROL_TOKEN=
APEX_RESEARCH_TOKEN=
APEX_OPPORTUNITY_ENGINE_TOKEN=
APEX_OPPORTUNITY_ENGINE_SYNC_TOKEN=

# Authenticated peer CAS — placeholders only; no production readiness is implied.
# APEX_PEER_CAS_NAMESPACE is one canonical app per current runtime instance.
# APEX_PEER_CAS_PEERS format: peerId=/ip4/203.0.113.10/tcp/4001/p2p/peerId;peerId2=/ip4/203.0.113.11/tcp/4001/p2p/peerId2
# Configure distinct APEX_PEER_FAILURE_DOMAIN_<peerId> values for independently operated failure domains.
APEX_PEER_CAS_NAMESPACE=
APEX_PEER_CAS_ENCRYPTION_KEY_BASE64=
APEX_PEER_CAS_PEERS=
APEX_PEER_CAS_REPLICAS=2
APEX_PEER_CAS_FAILURE_DOMAINS=2
APEX_PEER_FAILURE_DOMAIN_peerId=
APEX_PEER_CAS_ALLOWED_MODELS=
APEX_PEER_CAS_TOKEN=
APEX_PEER_CAS_SOCKET=/tmp/apex_peer_cas.sock
APEX_ALLOWED_PEER_IDS=
APEX_BOOTSTRAP_PEERS=
APEX_PEER_PRIVATE_KEY_BASE64=

# Storage-peer operator settings (configure on each actual peer machine only).
# The root is peer-owned durable capacity, not an application-host fallback.
APEX_PEER_STORAGE_ENABLED=false
APEX_PEER_STORAGE_BACKEND_MODULE=./src/core/peer-owned-binary-backend.mjs
APEX_PEER_NAMESPACE_ACL=
APEX_PEER_OWNED_STORAGE_ROOT=
APEX_PEER_STORAGE_RECEIPT_KEY_BASE64=

# Authenticated remote Pure-WAL worker API
APEX_WORKER_API_URL=
APEX_WORKER_TOKEN=

# Legacy WAL locations retained as migration references only. Do not activate for production writes.
# APEX_WAL_DIR=/srv/apex/se-x/wal
# APEX_WAL_FILE=/srv/apex/se-x/wal/ring.wal.jsonl
# Generic S3-compatible object storage is NOT an acceptable production system of record.
# APEX_CAS_REMOTE_ENABLED is a legacy compatibility switch; enabling it does not satisfy peer-owned storage policy.
# Do not deploy this template until per-app peer adapter wiring and physical-peer recovery tests pass.
APEX_OBJECT_STORAGE_ENDPOINT=
APEX_OBJECT_STORAGE_BUCKET=
APEX_OBJECT_STORAGE_REGION=auto
APEX_OBJECT_STORAGE_ACCESS_KEY_ID=
APEX_OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Cloudflare R2 or AWS S3
AWS_REGION=auto
APEX_OBJECT_STORE_ENDPOINT=
APEX_OBJECT_STORE_BUCKET=
APEX_AV1_OUTPUT_PREFIX=av1
APEX_S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional compatibility aliases
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto

# AI providers — free-only rotation never falls back to paid endpoints.
# Free-tier availability, quotas, and pricing are provider-controlled and not guaranteed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
APEX_GEMINI_FREE_TIER_CONFIRMED=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
APEX_GROQ_FREE_TIER_CONFIRMED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
APEX_MISTRAL_FREE_TIER_CONFIRMED=false
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
APEX_CLOUDFLARE_FREE_TIER_CONFIRMED=false
POLLINATIONS_MODEL=openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5


# Autonomous Apex worker fleet
APEX_PERMANENT_WORKERS=1000
APEX_PERMANENT_WORKER_CONCURRENCY=32
APEX_PERMANENT_WORKER_RUN_MS=60000

APEX_WORKER_CONCURRENCY=32
APEX_WORKER_BATCH_SIZE=20
APEX_WORKER_POLL_MS=1000
