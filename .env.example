# Apex zero-disk AV1 production daemon
NODE_ENV=production
APEX_PRODUCTION_DB_FILE=./apex-production.sqlite
APEX_AV1_CONCURRENCY=2
APEX_AV1_MAX_ATTEMPTS=3
APEX_PRODUCTION_POLL_MS=1000
FFMPEG_PATH=ffmpeg

# Cloudflare R2 or AWS S3
AWS_REGION=auto
APEX_OBJECT_STORE_ENDPOINT=
APEX_OBJECT_STORE_BUCKET=
APEX_AV1_OUTPUT_PREFIX=av1
APEX_S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional compatibility aliases
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto

# AI providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5


# Autonomous Apex worker fleet
APEX_PERMANENT_WORKERS=1000
APEX_PERMANENT_WORKER_CONCURRENCY=32
APEX_PERMANENT_WORKER_RUN_MS=60000

# Apex YouTube channel
APEX_YOUTUBE_CHANNEL_URL=https://youtube.com/@thebiblicalunseen

APEX_WORKER_CONCURRENCY=32
APEX_WORKER_BATCH_SIZE=20
APEX_WORKER_POLL_MS=1000
