NODE_ENV=production
DATABASE_URL=

# Autonomous PostgreSQL worker
APEX_WORKER_ONLY=true
APEX_WORKER_CONCURRENCY=256
APEX_WORKER_BATCH_SIZE=256
APEX_WORKER_POLL_MS=1000
APEX_WORKER_DB_POOL_MAX=32

# Object storage / media outputs
AWS_REGION=auto
APEX_OBJECT_STORE_ENDPOINT=
APEX_OBJECT_STORE_BUCKET=
APEX_AV1_OUTPUT_PREFIX=av1
APEX_S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AI providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Apex YouTube channel
APEX_YOUTUBE_CHANNEL_URL=https://youtube.com/@thebiblicalunseen
